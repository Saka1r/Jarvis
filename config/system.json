      "model_path": "data/models/Meta-Llama-3.1-8B-Instruct-Q6_K.gguf",
      "n_ctx": 4096,
      "n_gpu_layers": -1,
      "n_threads": 8,
      "n_batch": 1024,
      "max_tokens": 256
