    "piper": {
      "model_path": "data/models/piper/ru-RU-irina-medium.onnx"
    }
  },
  "stt": {
    "provider": "vosk",
    "vosk": {
      "model_path": "data/models/vosk-model-small-ru-0.22",
      "sample_rate": 16000
    }
